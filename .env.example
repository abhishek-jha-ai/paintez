# Public site URL used for canonical + Open Graph URLs.
# Optional on Vercel — falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Lead delivery (leave blank for demo mode — submissions are logged only).
# Generic JSON webhook: Zapier Catch Hook, Make, GoHighLevel inbound webhook,
# HubSpot workflow webhook, n8n, etc.
QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_SECRET=
